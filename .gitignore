# ============================================================
#  Keil MDK + STM32CubeIDE + VS Code / Trae CN
#  - 仅提交“未编译前”的必要文件（源码 / 工程 / 手写脚本 / 共享 IDE 配置）
#  - 忽略编译产物与个人 IDE 状态
#  - 最后更新 2026-11-24：补 Keil 目标输出目录 / J-Link 个人配置 / .dep / .sct
#    （起因：acb9144 误把 9 个构建/调试产物提交进库，已由 e45444f 清理）
#  - ⚠ 本文件不支持“行尾注释”：`*.o   # 说明` 会把注释当成模式的一部分而失效，
#       说明一律写在模式上一行。
# ============================================================

# ------------------------------------------------------------
#  1. 通用编译中间文件
# ------------------------------------------------------------
*.d
# Keil 依赖清单，每次编译重写
*.dep
*.o
*.ko
*.obj
*.elf

# ------------------------------------------------------------
#  2. 链接器 / 库 / 预编译头
# ------------------------------------------------------------
*.ilk
# 链接映射表，只用于核尺寸，不入库
*.map
*.exp
*.gch
*.pch
*.lib
*.a
*.la
*.lo

# ------------------------------------------------------------
#  3. 固件镜像文件（编译产物，不提交）
# ------------------------------------------------------------
*.hex
*.bin
*.axf

# ------------------------------------------------------------
#  4. 调试 / 列表 / 报告文件
# ------------------------------------------------------------
*.dSYM/
*.su
*.idb
*.pdb
*.lst
*.list
*.htm
# Keil 的 *.build_log.htm、静态调用树等
*.html
*.build_log

# ------------------------------------------------------------
#  5. Keil MDK（µVision）
# ------------------------------------------------------------
*.plg
*.lnp
*.crf
*.uvopt
# 个人调试/窗口布局状态；.uvprojx 在文末白名单保留
*.uvoptx
# 窗口布局 *.uvguix.<用户名>，换台机器就变
*.uvguix*
# 分散加载文件由 Keil 自动生成，见文末白名单说明
*.sct

# Keil 目标输出目录：.o / .d / .dep / .hex / .map / .sct / .lnp / .htm 全在里面，
# 由 uvprojx 随时可重新生成 —— 整个目录不入库
MDK-ARM/rp_disp/

# Keil RTE 自动生成（RTE_Components.h、_<target>/ 组件配置、Device 调试配置）
MDK-ARM/RTE/

Objects/
Listings/
Build/

# ------------------------------------------------------------
#  5.1 调试器（J-Link）个人配置与日志
#      换人换机就需重配，不属于工程资产
# ------------------------------------------------------------
JLinkLog.txt
JLinkSettings.ini
# STM32F10x 调试器配置（.dbgconf / .dbgconf.base@x.y.z），Keil / J-Link 自动生成
*.dbgconf*

# ------------------------------------------------------------
#  6. STM32CubeIDE / Eclipse
# ------------------------------------------------------------
Debug/
Release/
build/
Binaries/
.metadata/
.managed_build_system/
.settings/

# ------------------------------------------------------------
#  7. GCC 分离调试信息
# ------------------------------------------------------------
*.dwo
*.dwp

# ------------------------------------------------------------
#  8. VS Code / Trae CN（基于 VS Code 架构，共用 .vscode 规范）
#     - 个人状态忽略（含工程子目录下的，如 MDK-ARM/.vscode/uv4.log）
#     - 团队共享配置在文末白名单强制保留
# ------------------------------------------------------------
*.code-workspace
**/.vscode/*.log
**/.vscode/*.log.lock
.trae/

# ------------------------------------------------------------
#  9. 编辑器备份 / 临时文件
# ------------------------------------------------------------
*~
*.swp
*.swo
*.bak
*.tmp
*.temp
.idea/
.vs/

# ------------------------------------------------------------
# 10. 操作系统杂项
# ------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ============================================================
# 11. 白名单：强制保留“未编译前的必要文件”
#     （即使上方有通配符，下列文件也一定被提交）
# ============================================================

# --- 工程结构 ---
!*.uvprojx
!*.uvproj
!*.ioc
!.project
!.cproject

# --- 源码 ---
!*.c
!*.h
!*.cpp
!*.hpp
!*.s
!*.S
!*.inc

# --- 手写脚本（若由 CubeMX/Keil 自动生成，请删掉对应行）---
!*.ld
# !*.sct
#   ↑ 本工程的 .sct 全部由 Keil 生成（MDK-ARM/rp_disp/ 内），已按生成物忽略。
#     若以后改为手写分散加载文件，取消上面这行的注释即可重新纳入版本库。
!Makefile
!CMakeLists.txt

# --- 共享 IDE 配置（VS Code / Trae CN 团队复用）---
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json
!.vscode/c_cpp_properties.json

# --- 文档 ---
!README*
!LICENSE*
!*.md
